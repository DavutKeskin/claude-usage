#!/usr/bin/env python3
"""Claude Code token kullanımı ve limit raporu (hesap → gün → proje → oturum).

Kullanım:
  claude-usage                 # dün + bugün
  claude-usage -d 7            # son 7 gün
  claude-usage -o ~/claude-usage   # raporu dosyaya yaz (YYYY-MM-DD.md + latest.md)
  claude-usage --no-live       # API'ye gitme, sadece yerel önbellek
  claude-usage --no-titles     # oturum adlarını gizle (raporu paylaşırken)
  claude-usage --json          # ham veri

Yapılandırma gerekmez: $CLAUDE_CONFIG_DIR, ~/.claude ve ~/.claude-* dizinleri otomatik
bulunur; hesap etiketi e-postadan, plan çarpanı (Max 5x/20x) .claude.json'dan okunur.
İsteğe bağlı geçersiz kılma: ~/.config/claude-usage/config.json  (bkz. README)

Veri kaynakları (hepsi yerel; yalnızca limit yüzdeleri için api.anthropic.com'a gidilir):
  - <config>/projects/**/*.jsonl   transcript'ler (token sayıları)
  - <config>/history.jsonl         oturum → hesap eşlemesi (istem zamanına göre)
  - <config>/.credentials.json     OAuth token → /api/oauth/usage (canlı limit yüzdeleri)
  - <config>/.claude.json          cachedUsageUtilization (token süresi dolmuşsa yedek)
"""
import argparse, bisect, glob, hashlib, json, os, re, subprocess, sys, time, urllib.request, urllib.error
from collections import defaultdict
from datetime import datetime, timedelta, timezone

HOME = os.path.expanduser("~")

# ── Ayarlar ────────────────────────────────────────────────────────────────
CONFIG_FILE = os.path.join(HOME, ".config", "claude-usage", "config.json")
ACCOUNTS = []      # [(config dizini, etiket, plan çarpanı)] — etiket başına tek satır
HISTORY_DIRS = []  # [(config dizini, etiket)] — aynı hesaba ait tüm dizinler
PAST_ACCOUNTS = [] # [(config dizini, etiket, plan çarpanı)] — dizinde eskiden oturum açmış hesaplar
LOGINS = {}        # config dizini -> [(başlangıç ms, e-posta, tier)] (yalnızca otomatik keşifte)
CAPACITY_1X = {}   # {"week": $, "fable": $, "five": $} — 1x plan kapasitesi (isteğe bağlı)
# Tek hesap bulunduğunda kapasite tabanı (Ekim 2026, tek kullanıcılı Max 5x; README: Kalibrasyon)
REFERENCE_1X = {"week": 118, "fable": 37, "five": 16}

# $/M token: (input, output, 5 dk cache yazma, cache okuma); 1 saatlik cache yazma = 2 × input.
# Anahtar model adının önekidir, en uzun eşleşen kullanılır (claude-opus-5-5 ≠ claude-opus-5).
PRICE = {
    "claude-fable-5-1": (10, 50, 12.5, 0.25),
    "claude-fable-5":   (10, 50, 12.5, 1),
    "claude-opus-5-5":  (4, 20, 5, 0.2),
    "claude-opus-5":    (5, 25, 6.25, 0.5),
    "claude-opus-4-8":  (5, 25, 6.25, 0.5),
    "claude-opus-4-7":  (5, 25, 6.25, 0.5),
    "claude-sonnet-5-5": (2, 10, 2.5, 0.1),
    "claude-sonnet-5":  (2, 10, 2.5, 0.2),
    "claude-sonnet-4-6": (3, 15, 3.75, 0.3),
    "claude-haiku-5-5": (0.1, 0.5, 0.125, 0.01),
    "claude-haiku-4-5": (1, 5, 1.25, 0.1),
}
# İstem (input + cache) eşiği aşınca tüm fiyatlar çarpanla artar: {önek: (eşik, çarpan)}
LONG_PROMPT = {"claude-haiku-5-5": (100_000, 5)}
DEFAULT_PRICE = (5, 25, 6.25, 0.5)
USAGE_URL = "https://api.anthropic.com/api/oauth/usage"

# Status line ve uyarı hook'ları (--statusline, --hook)
STATE_DIR = os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.join(HOME, ".local", "state"),
                         "claude-usage")
FIVE_ALERTS = (70, 85, 95)            # 5 saatlik pencere yüzdesi eşikleri
WEEK_ALERTS = (75, 90, 95)            # haftalık pencere yüzdesi eşikleri
PACE_ALERT = 15                       # haftalık kullanım geçen sürenin bu kadar puan önündeyse uyar
CONTEXT_ALERTS = (400_000, 700_000)   # bağlam boyutu (token) eşikleri
COLD_CACHE_MIN = 50_000               # bundan küçük bağlamda soğuk cache uyarısı yok
# ───────────────────────────────────────────────────────────────────────────


def _read_json(path):
    try:
        with open(path) as f:
            return json.load(f)
    except Exception:
        return {}


def claude_json(d):
    """<dir>/.claude.json; varsayılan ~/.claude için dosya ~/.claude.json da olabilir."""
    cands = [os.path.join(d, ".claude.json")]
    if os.path.realpath(d) == os.path.realpath(os.path.join(HOME, ".claude")):
        cands.append(os.path.join(HOME, ".claude.json"))
    first = {}
    for p in cands:
        j = _read_json(p)
        if j.get("oauthAccount"):
            return j
        first = first or j
    return first


def load_credentials(d):
    """claudeAiOauth sözlüğü; Linux'ta dosya, macOS'ta anahtar zinciri (en iyi çaba)."""
    j = _read_json(os.path.join(d, ".credentials.json"))
    if not j and sys.platform == "darwin":
        try:
            out = subprocess.run(["security", "find-generic-password", "-s",
                                  "Claude Code-credentials", "-w"],
                                 capture_output=True, text=True, timeout=10).stdout
            j = json.loads(out)
        except Exception:
            j = {}
    return j.get("claudeAiOauth") or {}


def _email_tier(j):
    a = (j or {}).get("oauthAccount") or {}
    return a.get("emailAddress"), a.get("organizationRateLimitTier") or ""


def tier_mult(tier):
    m = re.search(r"(\d+)x", tier or "")
    return int(m.group(1)) if m else 1


def account_history(d, cur=None):
    """Dizinde zaman içinde oturum açmış hesaplar: [(başlangıç ms, e-posta, tier)], eskiden yeniye.
    Aynı dizinde /login ile hesap değişince eski kullanım eski hesaba yazılsın diye tutulur. Değişim
    anı Claude Code'un <dir>/backups/.claude.json.backup.<ms> yedeklerinden bulunur (önceki hesabın
    yerini başka bir şeyin ilk aldığı an); yedek yoksa değişimin fark edildiği an."""
    p = state_path("logins", dir_key(d))
    hist = [tuple(h) for h in _read_json(p).get("history") or []]
    email, tier = cur or _email_tier(claude_json(d))
    if not email or (hist and hist[-1][1] == email):
        return hist or ([(0, email, tier)] if email else [])
    prev = hist[-1][1] if hist else None
    snaps = []
    for f in glob.glob(os.path.join(d, "backups", ".claude.json.backup.*")):
        try:
            ms = int(f.rsplit(".", 1)[1])
        except ValueError:
            continue
        if not hist or ms > hist[-1][0]:
            snaps.append((ms, f))
    away = None   # prev'in yerini ilk kez başka bir şeyin (çıkış ya da başka hesap) aldığı an
    for ms, f in sorted(snaps):
        e, t = _email_tier(_read_json(f))
        if e == prev:
            away = None
        elif away is None:
            away = ms
        if e and e != prev:
            hist.append((away if prev else 0, e, t))
            prev, away = e, None
    if prev != email:
        hist.append(((away or int(time.time() * 1000)) if prev else 0, email, tier))
    write_json(p, {"dir": os.path.abspath(d), "history": hist})
    return hist


def label_at(d, ms, default):
    """d dizininde ms anında oturum açık hesap."""
    h = LOGINS.get(d)
    if not h:
        return default
    i = bisect.bisect_right([x[0] for x in h], ms)
    return h[i - 1][1] if i else h[0][1]


def discover_accounts():
    """ACCOUNTS / HISTORY_DIRS / CAPACITY_1X / PRICE değerlerini doldurur."""
    cfg = _read_json(CONFIG_FILE)
    for k, v in (cfg.get("prices") or {}).items():
        PRICE[k] = tuple(v)
    cap = cfg.get("capacity_1x") or {}
    if cfg.get("capacity_1x_week"):
        cap.setdefault("week", cfg["capacity_1x_week"])
    CAPACITY_1X.update({k: float(v) for k, v in cap.items() if v})

    found = []   # (dir, label, mult)
    auto = not cfg.get("accounts")
    if not auto:
        for a in cfg["accounts"]:
            d = os.path.expanduser(a["dir"])
            found.append((d, a.get("label") or os.path.basename(d), a.get("multiplier")))
    else:
        cands = [os.environ.get("CLAUDE_CONFIG_DIR"), os.path.join(HOME, ".claude")]
        cands += sorted(glob.glob(os.path.join(HOME, ".claude-*")))
        seen = set()
        for d in cands:
            if not d or not os.path.isdir(d) or os.path.realpath(d) in seen:
                continue
            if not (os.path.exists(os.path.join(d, "history.jsonl"))
                    or os.path.exists(os.path.join(d, ".credentials.json"))):
                continue
            seen.add(os.path.realpath(d))
            email = (claude_json(d).get("oauthAccount") or {}).get("emailAddress")
            found.append((d, email or os.path.basename(d), None))
    labels = set()
    for d, label, mult in found:
        HISTORY_DIRS.append((d, label))
        if label in labels:
            continue
        labels.add(label)
        if not mult:
            # .claude.json plan değişince güncellenir; credentials ancak token yenilenince
            mult = tier_mult((claude_json(d).get("oauthAccount") or {}).get("organizationRateLimitTier")
                             or load_credentials(d).get("rateLimitTier"))
        ACCOUNTS.append((d, label, mult))
    if not ACCOUNTS:
        sys.exit("Claude Code yapılandırma dizini bulunamadı (~/.claude, ~/.claude-*, $CLAUDE_CONFIG_DIR).")
    if auto:
        for d, _ in HISTORY_DIRS:
            try:
                LOGINS[d] = account_history(d)
            except OSError:
                continue
            for _, e, t in LOGINS[d]:
                if e not in labels:
                    labels.add(e)
                    PAST_ACCOUNTS.append((d, e, tier_mult(t)))


def project_roots():
    roots = []
    for d, _ in HISTORY_DIRS:
        r = os.path.realpath(os.path.join(d, "projects"))
        if os.path.isdir(r) and r not in roots:
            roots.append(r)
    return roots


def fmt(n):
    return f"{int(round(n)):,}".replace(",", ".")


def price_for(model):
    if not model or model == "<synthetic>":
        return None
    k = max((k for k in PRICE if model.startswith(k)), key=len, default=None)
    return PRICE[k] if k else DEFAULT_PRICE


def cache_writes(u):
    """(5 dk, 1 saat) cache yazma tokenları. Çok iterasyonlu yanıtta üst düzey cache_creation
    kırılımı eksik kalabildiği için executor iterasyonlarından toplanır."""
    its = [x for x in u.get("iterations") or [] if x.get("type") == "message"] or [u]
    w5 = w1 = 0
    for x in its:
        cc = x.get("cache_creation_input_tokens", 0)
        h = min(cc, (x.get("cache_creation") or {}).get("ephemeral_1h_input_tokens", 0))
        w5, w1 = w5 + cc - h, w1 + h
    return w5, w1


def cost(model, u):
    p = price_for(model)
    if not p:
        return 0.0
    w5, w1 = cache_writes(u)
    c = (u.get("input_tokens", 0) * p[0] + u.get("output_tokens", 0) * p[1]
         + w5 * p[2] + w1 * 2 * p[0] + u.get("cache_read_input_tokens", 0) * p[3]) / 1e6
    for k, (limit, factor) in LONG_PROMPT.items():
        if model.startswith(k) and (u.get("input_tokens", 0) + u.get("cache_creation_input_tokens", 0)
                                    + u.get("cache_read_input_tokens", 0)) > limit:
            c *= factor
    return c


def is_fable(model):
    return bool(model) and model.startswith("claude-fable")


def local_day(dt):
    return dt.astimezone().strftime("%Y-%m-%d")


_FRAC = re.compile(r"\.(\d+)")


def parse_ts(s):
    s = s.replace("Z", "+00:00")
    s = _FRAC.sub(lambda m: "." + (m.group(1) + "000000")[:6], s, count=1)
    dt = datetime.fromisoformat(s)
    return dt if dt.tzinfo else dt.replace(tzinfo=timezone.utc)


def loc(s):
    return parse_ts(s).astimezone().strftime("%d %b %H:%M") if s else "?"


# ── Canlı limitler ─────────────────────────────────────────────────────────
def no_limits(source=None):
    return {"five": None, "five_reset": None, "week": None, "week_reset": None,
            "week_start": None, "fable": None, "fable_reset": None, "source": source, "age_min": None}


def fetch_limits(cfg, live=True):
    """{'five':%, 'five_reset', 'week':%, 'week_reset', 'week_start', 'fable':%, 'source'}"""
    out = no_limits()
    d = cfg
    j = None
    if live:
        try:
            cred = load_credentials(d)
            if not cred.get("accessToken"):
                out["source"] = "token yok → önbellek"
            elif cred.get("expiresAt", 0) / 1000 > time.time():
                req = urllib.request.Request(USAGE_URL, headers={
                    "Authorization": "Bearer " + cred["accessToken"],
                    "anthropic-beta": "oauth-2025-04-20",
                    "User-Agent": "claude-code", "Accept": "application/json"})
                j = json.load(urllib.request.urlopen(req, timeout=20))
                out["source"], out["age_min"] = "canlı", 0
            else:
                out["source"] = "token süresi dolmuş → önbellek"
        except Exception as e:  # noqa
            out["source"] = f"canlı alınamadı ({type(e).__name__}) → önbellek"
    if j is None:
        try:
            c = claude_json(d).get("cachedUsageUtilization")
            if c:
                j = c["utilization"]
                age = out["age_min"] = (time.time() * 1000 - c.get("fetchedAtMs", 0)) / 60000
                out["source"] = (out["source"] or "önbellek") + f" ({age:.0f} dk önce)"
        except Exception:
            pass
    if j is None:
        out["source"] = out["source"] or "veri yok"
        return out
    fh, sd = j.get("five_hour") or {}, j.get("seven_day") or {}
    out["five"], out["five_reset"] = fh.get("utilization"), fh.get("resets_at")
    out["week"], out["week_reset"] = sd.get("utilization"), sd.get("resets_at")
    b = j.get("seven_day_breakdown") or {}
    out["week_start"] = b.get("window_started_at")
    if not out["week_start"] and out["week_reset"]:
        out["week_start"] = (parse_ts(out["week_reset"]) - timedelta(days=7)).isoformat()
    for l in j.get("limits") or []:
        if l.get("kind") == "weekly_scoped":
            name = ((l.get("scope") or {}).get("model") or {}).get("display_name", "")
            if "Fable" in str(name):
                out["fable"], out["fable_reset"] = l.get("percent"), l.get("resets_at")
    # Önbellek eskiyse pencere çoktan sıfırlanmış olabilir: yanıltıcı değerleri gösterme
    # ve o eski pencere üzerinden maliyet toplama.
    now = datetime.now(timezone.utc)
    if out["five_reset"] and parse_ts(out["five_reset"]) < now:
        out["five"] = out["five_reset"] = None
        out["source"] += "; 5s penceresi sıfırlanmış"
    if out["week_reset"] and parse_ts(out["week_reset"]) < now:
        out["week"] = out["fable"] = out["week_reset"] = out["week_start"] = out["fable_reset"] = None
        out["source"] += "; haftalık pencere sıfırlanmış"
    return out


# ── Oturum → hesap eşlemesi ────────────────────────────────────────────────
def load_timeline():
    """tl: sid -> [(ts_ms, hesap)];  first_prompt: sid -> ilk istem (oturum adı yedeği)"""
    tl, first = defaultdict(list), {}
    for cfg, label in HISTORY_DIRS:
        p = os.path.join(cfg, "history.jsonl")
        if not os.path.exists(p):
            continue
        for line in open(p, errors="ignore"):
            try:
                j = json.loads(line)
            except ValueError:
                continue
            sid = j.get("sessionId")
            if sid and j.get("timestamp"):
                tl[sid].append((j["timestamp"], label_at(cfg, j["timestamp"], label)))
                d = (j.get("display") or "").strip()
                if d and not d.startswith("/") and (sid not in first or j["timestamp"] < first[sid][0]):
                    first[sid] = (j["timestamp"], d)
    for s in tl:
        tl[s].sort()
    return tl, {s: v[1] for s, v in first.items()}


def account_for(tl, sid, ms):
    t = tl.get(sid)
    if not t:
        # history'de olmayan oturum (başka makineden taşınmış vb.): tek hesap varsa onundur
        return label_at(ACCOUNTS[0][0], ms, ACCOUNTS[0][1]) if len(ACCOUNTS) == 1 else None
    i = bisect.bisect_right([x for x, _ in t], ms)
    return t[i - 1][1] if i else t[0][1]


# ── Transcript tarama ──────────────────────────────────────────────────────
def scan(since_dt, tl, titles):
    """Her mesaj için (dt, acct, proj, sid, model, usage, advisor_mu) üretir; titles[sid] = ai-title.
    Advisor alt çağrıları üst düzey usage'a dahil değildir (usage.iterations); advisor modeliyle
    ayrı kayıt olarak üretilir."""
    seen = set()
    home_enc = HOME.replace("/", "-")
    names = {}   # proje dizini -> görünen ad (transcript'teki ilk cwd)
    files = [(root, f) for root in project_roots()
             for f in glob.glob(root + "/**/*.jsonl", recursive=True)]
    for root, f in files:
        try:
            if os.path.getmtime(f) < since_dt.timestamp():
                continue
            fh = open(f, errors="ignore")
        except OSError:
            continue
        rel = os.path.relpath(f, root).split("/")
        if len(rel) < 2:
            continue
        pdir = rel[0]
        sid = rel[1].replace(".jsonl", "")
        rest = pdir[len(home_enc):] if pdir.startswith(home_enc) else pdir
        fallback = ("~/" + rest.lstrip("-")) if pdir.startswith(home_enc) and rest else ("~" if not rest else pdir)
        # Yanıt, içerik bloğu başına bir satır olarak yazılır; ilk satırların output_tokens'ı
        # stream sırasında eksik kalabilir → anahtar başına en büyük output'lu satır alınır.
        msgs = {}   # (message.id, requestId) -> (ilk zaman, model, usage)
        for line in fh:
            try:
                j = json.loads(line)
            except ValueError:
                continue
            if pdir not in names and j.get("cwd"):
                c = j["cwd"]
                names[pdir] = "~" + c[len(HOME):] if c == HOME or c.startswith(HOME + "/") else c
            t = j.get("type")
            if t == "ai-title" and j.get("aiTitle"):
                titles[sid] = j["aiTitle"]
                continue
            if t != "assistant":
                continue
            m = j.get("message") or {}
            u, ts = m.get("usage"), j.get("timestamp")
            if not u or not ts:
                continue
            key = (m.get("id"), j.get("requestId"))
            old = msgs.get(key)
            if not old or u.get("output_tokens", 0) >= old[2].get("output_tokens", 0):
                msgs[key] = (old[0] if old else ts, m.get("model", ""), u)
        proj = names.get(pdir, fallback)
        for key, (ts, model, u) in msgs.items():
            if key in seen:
                continue
            seen.add(key)
            dt = parse_ts(ts)
            acct = account_for(tl, sid, dt.timestamp() * 1000)
            yield dt, acct, proj, sid, model, u, False
            for it in u.get("iterations") or []:
                if it.get("type") == "advisor_message":
                    yield dt, acct, proj, sid, it.get("model") or "", it, True


# ── Status line ve uyarı hook'ları ─────────────────────────────────────────
# Status line, Claude Code'un verdiği oturum verisini (rate_limits, bağlam, maliyet, cache) gösterir
# ve durum dosyasına yazar; hook'lar ağa ya da transcript taramasına gitmeden bu dosyayı okur.
DAYS_TR = ("Pzt", "Sal", "Çar", "Per", "Cum", "Cmt", "Paz")


def config_dir_of(transcript_path):
    """Oturumun hesabı = transcript'in bulunduğu config dizini (<config>/projects/…)."""
    i = (transcript_path or "").rfind("/projects/")
    if i > 0:
        return transcript_path[:i]
    return os.environ.get("CLAUDE_CONFIG_DIR") or os.path.join(HOME, ".claude")


def dir_key(d):
    d = os.path.abspath(d)
    return os.path.basename(d).lstrip(".") + "-" + hashlib.sha1(d.encode()).hexdigest()[:6]


def account_key(d, email):
    """Durum dosyası anahtarı: dizin + hesap. Aynı dizinde /login ile hesap değişirse yeni hesap
    eskisinin limitlerini ve uyarı durumunu devralmaz."""
    return dir_key(d) + "-" + hashlib.sha1(email.encode()).hexdigest()[:6]


def state_path(kind, key):
    return os.path.join(STATE_DIR, kind, f"{key}.json")


def write_text(path, text):
    """Atomik yazma: okuyan taraf yarım dosya görmez."""
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = f"{path}.{os.getpid()}.tmp"
    with open(tmp, "w") as f:
        f.write(text)
    os.replace(tmp, path)


def write_json(path, obj):
    write_text(path, json.dumps(obj, ensure_ascii=False))


def hm(ts):
    """Bugünse SS:DD, değilse 'Cmt 04:00'."""
    t = datetime.fromtimestamp(ts).astimezone()
    if t.date() == datetime.now().astimezone().date():
        return t.strftime("%H:%M")
    return f"{DAYS_TR[t.weekday()]} {t:%H:%M}"


def window(rl, name, now):
    """(yüzde, sıfırlanma epoch) ya da None — pencere yoksa ya da çoktan sıfırlandıysa."""
    w = (rl or {}).get(name) or {}
    u, r = w.get("used_percentage"), w.get("resets_at")
    return (float(u), float(r)) if u is not None and r and r > now else None


def week_pace(used, reset, now):
    """(geçen süre %, hafta ortalamasıyla dolma zamanı ya da None)."""
    start = reset - 7 * 86400
    elapsed = max(now - start, 1)
    fill = start + elapsed * 100 / used if used > 0 else None
    return 100 * elapsed / (7 * 86400), (fill if fill and fill < reset else None)


def merge_limits(old, new):
    """Pencere başına new'i alır; yalnızca old daha yeni bir pencereye aitse old kalır. Yüzde aynı
    pencerede de düşebilir (plan yükseltmesi, Anthropic'in sıfırlaması), en yüksek değer alınmaz."""
    out = dict(old or {})
    for name, w in (new or {}).items():
        o = out.get(name) or {}
        if not isinstance(w, dict) or not w.get("resets_at"):
            continue
        if w["resets_at"] >= (o.get("resets_at") or 0) - 600:
            out[name] = w
    return out


def context_tokens(cw):
    u = (cw or {}).get("current_usage") or {}
    return sum(u.get(k) or 0 for k in ("input_tokens", "cache_creation_input_tokens", "cache_read_input_tokens"))


def money(c):
    return f"${c:.2f}" if c < 10 else f"${c:.0f}"


def statusline():
    try:
        j = json.load(sys.stdin)
    except ValueError:
        j = {}
    m = j.get("model") or {}
    try:
        print(statusline_text(j, time.time()))
    except Exception:   # status line hiçbir zaman boş kalmasın
        print(m.get("display_name") or m.get("id") or "Claude")


def statusline_text(j, now):
    Y, R, Z = "\033[33m", "\033[31m", "\033[0m"
    m = j.get("model") or {}
    mid = m.get("id") or ""
    p = price_for(mid) or DEFAULT_PRICE
    ctx = context_tokens(j.get("context_window"))
    cost_usd = (j.get("cost") or {}).get("total_cost_usd")
    rl = j.get("rate_limits") or {}
    pc = j.get("prompt_cache") or {}
    sid = j.get("session_id")
    d = config_dir_of(j.get("transcript_path"))
    if sid:
        email, tier = _email_tier(claude_json(d))
        email = email or os.path.basename(d)
        account_history(d, (email, tier))   # hesap değiştiyse değişim anını kaydeder
        sess_p = state_path("session", sid)
        # Claude Code her çizimde oturumun son yanıtının rate_limits'ini yeniden verir; boşta bekleyen
        # oturumun eski değeri hesabın taze verisini ezmesin diye yalnızca değiştiyse yeni sayılır.
        fresh = bool(rl) and rl != _read_json(sess_p).get("rate_limits")
        st = {"at": now, "dir": d, "acct": email, "model": mid, "ctx": ctx, "cost": cost_usd,
              "rate_limits": rl}
        write_json(sess_p, st)
        acct_p = state_path("account", account_key(d, email))
        acct_rl = _read_json(acct_p).get("rate_limits")
        if fresh:
            rl = merge_limits(acct_rl, rl)
            write_json(acct_p, {"at": now, "dir": d, "acct": email, "rate_limits": rl})
        else:
            rl = merge_limits(rl, acct_rl)
    name = m.get("display_name") or mid or "Claude"
    effort = (j.get("effort") or {}).get("level")
    if effort:
        name += f" ({effort})"
    if j.get("fast_mode"):
        name += " ⚡fast"
    parts = [name]

    if ctx:
        s = f"bağlam {ctx // 1000}K"
        if ctx >= 200_000:
            s += f" (~{money(ctx * p[3] / 1e6)}/istek)"
        col = R if ctx >= CONTEXT_ALERTS[1] else Y if ctx >= CONTEXT_ALERTS[0] else ""
        parts.append(col + s + (Z if col else ""))
    if cost_usd is not None:
        parts.append(f"oturum {money(cost_usd)}")
    five = window(rl, "five_hour", now)
    if five:
        u, r = five
        col = R if u >= FIVE_ALERTS[1] else Y if u >= FIVE_ALERTS[0] else ""
        parts.append(f"{col}5s %{u:.0f} →{hm(r)}{Z if col else ''}")
    week = window(rl, "seven_day", now)
    if week:
        u, r = week
        el, fill = week_pace(u, r, now)
        s = f"hafta %{u:.0f} (süre %{el:.0f})"
        if fill and u - el >= 5:
            s += f" ⚠ ~{hm(fill)} dolar"
        col = R if u >= WEEK_ALERTS[1] else Y if u >= WEEK_ALERTS[0] or u - el >= PACE_ALERT else ""
        parts.append(col + s + (Z if col else ""))
    # Soğuk cache: sonraki istek tüm bağlamı yeniden yazar (1 saatlik yazma 2 × input)
    if pc and (not pc.get("warm") or (pc.get("expires_at") or now) < now):
        tok = pc.get("recache_tokens_if_cold") or ctx
        if tok >= COLD_CACHE_MIN:
            w = 2 * p[0] if pc.get("ttl") == "1h" else p[2]
            parts.append(f"{Y}❄ cache soğuk: sonraki istek ~{money(tok * w / 1e6)}{Z}")
    return " · ".join(parts)


def account_label(d):
    return (claude_json(d).get("oauthAccount") or {}).get("emailAddress") or os.path.basename(d)


def limit_alerts(st, now, seen):
    """Hesap limitleri için yeni eşik geçişleri; seen (hesap başına) günceller."""
    msgs = []
    rl = st.get("rate_limits") or {}
    five = window(rl, "five_hour", now)
    if five:
        u, r = five
        k = str(round(r / 600))   # resets_at saniye kayabilir: 10 dk'ya yuvarla
        prev = (seen.get("five") or {}).get(k, 0)
        thr = max((t for t in FIVE_ALERTS if u >= t), default=0)
        if thr > prev:
            msgs.append(f"5 saatlik limit %{u:.0f} (sıfırlanma {hm(r)})")
        seen["five"] = {k: max(thr, prev)}
    week = window(rl, "seven_day", now)
    if week:
        u, r = week
        k = str(round(r / 600))
        prev = (seen.get("week") or {}).get(k) or [0, 0]
        el, fill = week_pace(u, r, now)
        thr = max((t for t in WEEK_ALERTS if u >= t), default=0)
        band = int(u // 10) if u - el >= PACE_ALERT else 0   # hız uyarısı her 10 puanda bir
        if thr > prev[0] or band > prev[1]:
            s = f"haftalık limit %{u:.0f}, geçen süre %{el:.0f}"
            s += (f"; bu ortalamayla {hm(fill)} civarı dolar, sıfırlanma {hm(r)}" if fill
                  else f" (sıfırlanma {hm(r)})")
            msgs.append(s)
        seen["week"] = {k: [max(thr, prev[0]), max(band, prev[1])]}
    return msgs


def hook_stop(j, now):
    if j.get("stop_hook_active") or not j.get("session_id"):
        return None
    st = _read_json(state_path("session", j["session_id"]))
    if not st or now - st.get("at", 0) > 6 * 3600:
        return None
    d = st.get("dir") or config_dir_of(j.get("transcript_path"))
    email = st.get("acct") or account_label(d)
    seen_p = state_path("alerts", account_key(d, email))
    seen = _read_json(seen_p)
    acct = _read_json(state_path("account", account_key(d, email)))
    msgs = limit_alerts({"rate_limits": merge_limits(st.get("rate_limits"), acct.get("rate_limits"))},
                        now, seen)

    # Bağlam: oturum başına; /compact sonrası eşiğin altına inince sıfırlanır
    ctx_p = state_path("session", j["session_id"] + ".alert")
    prev = _read_json(ctx_p).get("ctx", 0)
    ctx = st.get("ctx") or 0
    thr = max((t for t in CONTEXT_ALERTS if ctx >= t), default=0)
    if thr > prev:
        p = price_for(st.get("model")) or DEFAULT_PRICE
        s = (f"bağlam {ctx // 1000}K token: her istek en az ~{money(ctx * p[3] / 1e6)} (cache okuma); "
             "konu değiştiyse /compact ya da yeni oturum")
        if st.get("cost") is not None:
            s += f". Bu oturum şimdiye dek ~{money(st['cost'])} (Claude Code tahmini)"
        msgs.append(s)
    if thr != prev:
        write_json(ctx_p, {"ctx": thr})
    write_json(seen_p, seen)
    if msgs:
        return {"systemMessage": f"⚠ claude-usage [{email}]: " + "; ".join(msgs)}
    return None


def last_usage(path, tail=4 << 20):
    """Transcript'teki son yanıt: (zaman, model, usage, 1 saatlik cache mi). Cache süresi son
    yanıtlardaki cache yazmalarından anlaşılır; hiç yazma görülmezse 1 saat (abonelik varsayılanı)."""
    try:
        with open(path, "rb") as f:
            f.seek(0, 2)
            f.seek(max(0, f.tell() - tail))
            lines = f.read().decode("utf-8", "ignore").splitlines()
    except OSError:
        return None
    last = None
    for line in reversed(lines):
        try:
            x = json.loads(line)
        except ValueError:
            continue
        msg = x.get("message") or {}
        u = msg.get("usage")
        if x.get("type") != "assistant" or not u or not x.get("timestamp") or x.get("isSidechain"):
            continue
        last = last or (parse_ts(x["timestamp"]).timestamp(), msg.get("model") or "", u)
        cc = u.get("cache_creation") or {}
        if cc.get("ephemeral_1h_input_tokens"):
            return last + (True,)
        if cc.get("ephemeral_5m_input_tokens"):
            return last + (False,)
    return last + (True,) if last else None


def hook_session_start(j, now):
    msgs = []
    if j.get("source") == "resume" and j.get("transcript_path"):
        r = last_usage(j["transcript_path"])
        if r:
            ts, model, u, one_hour = r
            ctx = context_tokens({"current_usage": u})
            age = now - ts
            if ctx >= COLD_CACHE_MIN and age > (3600 if one_hour else 300):
                p = price_for(model) or DEFAULT_PRICE
                c = ctx * (2 * p[0] if one_hour else p[2]) / 1e6
                ago = f"{age / 3600:.0f} saat" if age >= 5400 else f"{age / 60:.0f} dk"
                msgs.append(f"önbellek soğudu (son yanıt {ago} önce): ilk mesaj {ctx // 1000}K token'ı "
                            f"yeniden yazar, ~{money(c)} ({model} liste fiyatı). Konu değiştiyse yeni "
                            "oturum daha ucuz")
    d = config_dir_of(j.get("transcript_path"))
    email = account_label(d)
    st = _read_json(state_path("account", account_key(d, email)))
    if st and now - st.get("at", 0) < 12 * 3600:
        rl = st.get("rate_limits") or {}
        five, week = window(rl, "five_hour", now), window(rl, "seven_day", now)
        s = []
        if week and (week[0] >= WEEK_ALERTS[0] or week[0] - week_pace(*week, now)[0] >= PACE_ALERT):
            el, fill = week_pace(*week, now)
            s.append(f"haftalık %{week[0]:.0f} (geçen süre %{el:.0f}"
                     + (f", bu ortalamayla {hm(fill)} civarı dolar)" if fill else ")"))
        if five and five[0] >= FIVE_ALERTS[0]:
            s.append(f"5 saatlik %{five[0]:.0f} (sıfırlanma {hm(five[1])})")
        if s:
            msgs.append(f"hesap durumu ({hm(st['at'])} itibarıyla): " + ", ".join(s))
    # eski durum dosyalarını temizle (logins/ hesap geçmişidir, silinmez)
    for kind in ("session", "account", "alerts"):
        for f in glob.glob(os.path.join(STATE_DIR, kind, "*.json")):
            try:
                if now - os.path.getmtime(f) > 8 * 86400:
                    os.remove(f)
            except OSError:
                pass
    if msgs:
        return {"systemMessage": f"claude-usage [{email}]: " + "; ".join(msgs)}
    return None


def run_hook(event):
    try:
        j = json.load(sys.stdin)
        out = (hook_stop if event == "stop" else hook_session_start)(j, time.time())
        if out:
            print(json.dumps(out, ensure_ascii=False))
    except Exception as e:   # hook hiçbir zaman oturumu bozmasın
        print(f"claude-usage --hook {event}: {type(e).__name__}: {e}", file=sys.stderr)


# ── Ayar kurulumu ──────────────────────────────────────────────────────────
HOOK_EVENTS = (("Stop", None, "--hook stop"), ("SessionStart", "startup|resume", "--hook session-start"))


def install_hooks(remove=False):
    """Bulunan her config dizininin settings.json'ına status line ve hook'ları ekler (ya da kaldırır)."""
    exe = os.path.abspath(sys.argv[0])
    dirs = []
    for d, _ in HISTORY_DIRS:
        if os.path.realpath(d) not in [os.path.realpath(x) for x in dirs]:
            dirs.append(d)
    for d in dirs:
        path = os.path.join(d, "settings.json")
        try:
            with open(path) as f:
                raw = f.read()
            s = json.loads(raw) if raw.strip() else {}
        except FileNotFoundError:
            raw, s = "", {}
        except ValueError:
            print(f"{path}: geçerli JSON değil, dokunulmadı")
            continue
        notes = []
        sl = s.get("statusLine") or {}
        ours = "claude-usage --statusline" in (sl.get("command") or "")
        if remove:
            if ours:
                del s["statusLine"]
                notes.append("status line kaldırıldı")
        elif not sl or ours:
            s["statusLine"] = {"type": "command", "command": f"{exe} --statusline"}
            notes.append("status line")
        else:
            notes.append("mevcut status line korundu (elle: " + exe + " --statusline)")
        hooks = s.setdefault("hooks", {})
        for event, matcher, arg in HOOK_EVENTS:
            groups = hooks.get(event) or []
            for g in groups:   # eski kurulumları (başka yol) temizle
                g["hooks"] = [h for h in g.get("hooks") or [] if "claude-usage " + arg not in (h.get("command") or "")]
            groups = [g for g in groups if g.get("hooks")]
            if not remove:
                g = {"hooks": [{"type": "command", "command": f"{exe} {arg}", "timeout": 5}]}
                if matcher:
                    g["matcher"] = matcher
                groups.append(g)
                notes.append(f"{event} hook")
            if groups:
                hooks[event] = groups
            else:
                hooks.pop(event, None)
        if not hooks:
            s.pop("hooks", None)
        new = json.dumps(s, ensure_ascii=False, indent=2) + "\n"
        if new == raw:
            print(f"{path}: değişiklik yok")
            continue
        if raw:
            write_text(path + ".claude-usage.bak", raw)
        write_text(path, new)
        print(f"{path}: " + ", ".join(notes) + (f" (yedek: {path}.claude-usage.bak)" if raw else ""))
    if not remove:
        print("Açık oturumlar yeni ayarları genelde kendiliğinden alır; almazsa Claude Code'u yeniden başlatın.")


# ── Ana ────────────────────────────────────────────────────────────────────
def main():
    if sys.argv[1:2] == ["--statusline"]:   # her mesajda çalışır: ağır işlerden önce ayrıl
        return statusline()
    if sys.argv[1:2] == ["--hook"]:
        return run_hook(sys.argv[2] if len(sys.argv) > 2 else "")
    ap = argparse.ArgumentParser(description="Claude Code kullanım raporu")
    ap.add_argument("-d", "--days", type=int, default=2, help="kaç gün geriye (varsayılan 2 = dün+bugün)")
    ap.add_argument("--no-live", action="store_true", help="API'ye gitme, önbellek kullan")
    ap.add_argument("--json", action="store_true")
    ap.add_argument("-o", "--out", metavar="DIZIN",
                    help="raporu DIZIN/YYYY-MM-DD.md dosyasına yaz (latest.md de güncellenir)")
    ap.add_argument("-s", "--sessions", type=int, default=12, metavar="N",
                    help="hesap/gün başına gösterilecek en pahalı N oturum (0 = kapat)")
    ap.add_argument("--no-titles", action="store_true",
                    help="oturum adlarını gizle (yalnızca kısa kimlik)")
    ap.add_argument("--capacity-1x-week", type=float, metavar="USD",
                    help="1x planın haftalık kapasitesi ($, liste fiyatıyla). Paylaşılan tek "
                         "hesapta 'bu makinenin payı'nı doğru hesaplamak için; bkz. README")
    ap.add_argument("--statusline", action="store_true",
                    help="Claude Code status line'ı (stdin: Claude Code'un oturum JSON'u)")
    ap.add_argument("--hook", choices=["stop", "session-start"],
                    help="uyarı hook'u (stdin: hook JSON'u); limit eşiği aşılınca mesaj gösterir")
    ap.add_argument("--install-hooks", action="store_true",
                    help="bulunan her config dizininin settings.json'ına status line ve hook'ları ekle")
    ap.add_argument("--uninstall-hooks", action="store_true", help="eklenenleri kaldır")
    a = ap.parse_args()
    discover_accounts()
    if a.install_hooks or a.uninstall_hooks:
        return install_hooks(remove=a.uninstall_hooks)
    if a.capacity_1x_week:
        CAPACITY_1X["week"] = a.capacity_1x_week
    if a.out and not a.json:
        import io, contextlib
        buf = io.StringIO()
        with contextlib.redirect_stdout(buf):
            report(a)
        os.makedirs(a.out, exist_ok=True)
        path = os.path.join(a.out, datetime.now().strftime("%Y-%m-%d") + ".md")
        with open(path, "w") as f:
            f.write(buf.getvalue())
        latest = os.path.join(a.out, "latest.md")
        try:
            if os.path.islink(latest) or os.path.exists(latest):
                os.remove(latest)
            os.symlink(os.path.basename(path), latest)
        except OSError:
            pass
        print(path)
        return
    report(a)


def report(a):

    today = datetime.now().astimezone().replace(hour=0, minute=0, second=0, microsecond=0)
    days = [(today - timedelta(days=i)).strftime("%Y-%m-%d") for i in range(a.days - 1, -1, -1)]
    labels = {days[-1]: "Bugün"}
    if len(days) > 1:
        labels[days[-2]] = "Dün"

    limits = {label: fetch_limits(cfg, live=not a.no_live) for cfg, label, _ in ACCOUNTS}
    for cfg, label, _ in PAST_ACCOUNTS:   # dizinde artık başka hesap açık: limitleri sorgulanamaz
        limits[label] = no_limits(f"önceki hesap ({os.path.basename(cfg)} dizininde artık başka hesap açık)")
    ALL = ACCOUNTS + PAST_ACCOUNTS
    past = {label for _, label, _ in PAST_ACCOUNTS}

    since = today - timedelta(days=a.days - 1)
    for L in limits.values():
        if L["week_start"]:
            since = min(since, parse_ts(L["week_start"]).astimezone())
    tl, first_prompt = load_timeline()
    titles = {}

    # toplayıcılar
    tok = defaultdict(lambda: defaultdict(int))     # (acct, day, proj) -> in/out/cc/cr/n
    dcost = defaultdict(float)                      # (acct, day, proj)
    dfable = defaultdict(float)                     # (acct, day, proj) fable maliyeti
    mdl = defaultdict(int)                          # (acct, day, model) -> output
    wcost, wfable, scost = defaultdict(float), defaultdict(float), defaultdict(float)
    sproj = defaultdict(float)                      # (acct, proj) 5s penceresi
    stok = defaultdict(lambda: defaultdict(int))    # (acct, day, sid) -> out/total/n
    scst = defaultdict(float)                       # (acct, day, sid) maliyet
    sfab = defaultdict(float)                       # (acct, day, sid) fable maliyeti
    sess_proj = {}                                  # sid -> proj
    for dt, acct, proj, sid, model, u, adv in scan(since, tl, titles):
        if not acct:
            continue
        c = cost(model, u)
        L = limits[acct]
        if L["week_start"] and dt >= parse_ts(L["week_start"]):
            wcost[acct] += c
            if is_fable(model):
                wfable[acct] += c
        if L["five_reset"] and dt >= parse_ts(L["five_reset"]) - timedelta(hours=5):
            scost[acct] += c
            sproj[(acct, proj)] += c
        day = local_day(dt)
        if day in days:
            k = (acct, day, proj)
            tok[k]["in"] += u.get("input_tokens", 0)
            tok[k]["out"] += u.get("output_tokens", 0)
            tok[k]["cc"] += u.get("cache_creation_input_tokens", 0)
            tok[k]["cr"] += u.get("cache_read_input_tokens", 0)
            tok[k]["n"] += not adv
            dcost[k] += c
            if is_fable(model):
                dfable[k] += c
            mdl[(acct, day, model + (" (advisor)" if adv else ""))] += u.get("output_tokens", 0)
            ks = (acct, day, sid)
            stok[ks]["out"] += u.get("output_tokens", 0)
            stok[ks]["total"] += (u.get("input_tokens", 0) + u.get("output_tokens", 0)
                                  + u.get("cache_creation_input_tokens", 0)
                                  + u.get("cache_read_input_tokens", 0))
            stok[ks]["n"] += not adv
            scst[ks] += c
            if is_fable(model):
                sfab[ks] += c
            sess_proj[sid] = proj

    def sess_name(sid):
        if a.no_titles:
            return "oturum"
        name = titles.get(sid) or first_prompt.get(sid) or ""
        name = " ".join(name.split())
        if len(name) > 48:
            name = name[:47] + "…"
        return name.replace("|", "\\|") or "(adsız)"

    # Kapasite kalibrasyonu: hesap başına "yerel maliyet / yüzde" → 1x kapasite.
    # Hesap başka makinelerden de kullanılıyorsa yerel maliyet düşük kalır; bu yüzden
    # hesaplar arasında en büyük 1x tahmini alınır (paylaşılan hesap için daha doğru).
    # Tek hesapta karşılaştırma yapılamaz: referans değer taban olarak kullanılır.
    # Eski önbellekteki yüzde, o andan sonraki yerel maliyetle bölününce kapasiteyi
    # şişirir; taze (≤ 60 dk) kaynak varsa yalnızca onlar kullanılır.
    fresh = [l for l, L in limits.items() if L["age_min"] is not None and L["age_min"] <= 60]
    ref = REFERENCE_1X if len(ACCOUNTS) == 1 else {}
    ref_used = set()

    def capacity(key_cost, key_pct, key_cfg):
        best = CAPACITY_1X.get(key_cfg) or ref.get(key_cfg, 0.0)
        for _, label, m in ACCOUNTS:
            if fresh and label not in fresh:
                continue
            p = limits[label].get(key_pct)
            c = key_cost[label]
            if p and p > 0 and c > 0:
                best = max(best, c / (p / 100) / m)
        if not best:   # hiçbir hesapta kalibre edilecek yüzde yok (pencere yeni ya da yüzde 0)
            best = REFERENCE_1X.get(key_cfg, 0.0)
            ref_used.add(key_cfg)
        return {label: best * m for _, label, m in ALL} if best else {}

    cap_w = capacity(wcost, "week", "week")
    cap_f = capacity(wfable, "fable", "fable")
    cap_s = capacity(scost, "five", "five")

    def share(c, cap):
        return f"%{100 * c / cap:.1f}" if cap else "–"

    if a.json:
        print(json.dumps({"limits": limits, "tokens": {"|".join(k): v for k, v in tok.items()},
                          "cost": {"|".join(k): v for k, v in dcost.items()},
                          "capacity": {"week": cap_w, "fable": cap_f, "five": cap_s}},
                         ensure_ascii=False, indent=1, default=str))
        return

    now = datetime.now().astimezone().strftime("%d %b %Y %H:%M")
    print(f"# Claude Code kullanım raporu — {now}\n")
    print("## Canlı limitler\n")
    print("| Hesap | 5 saatlik | Sıfırlanma | Haftalık | Fable haftalık | Haftalık sıfırlanma | Kaynak |")
    print("|---|---:|---|---:|---:|---|---|")
    for _, label, _ in ALL:
        L = limits[label]
        pct = lambda v: f"%{v:.0f}" if v is not None else "?"
        print(f"| {label} | {pct(L['five'])} | {loc(L['five_reset'])} | {pct(L['week'])} | "
              f"{pct(L['fable'])} | {loc(L['week_reset'])} | {L['source']} |")

    print("\nBu makinenin haftalık pencere içindeki payı (tahmini):\n")
    print("| Hesap | Yerel maliyet | Haftalık limit payı | Fable yerel | Fable limit payı | 5s yerel | 5s limit payı |")
    print("|---|---:|---:|---:|---:|---:|---:|")
    for _, label, _ in ACCOUNTS:
        L = limits[label]
        note = ""
        if cap_w.get(label) and L["week"]:
            local_pct = 100 * wcost[label] / cap_w[label]
            if L["week"] - local_pct > 10:
                note = f" ⚠ hesabın %{L['week'] - local_pct:.0f}'i başka makine/kişiden"
        print(f"| {label} | ${wcost[label]:,.0f} | {share(wcost[label], cap_w.get(label))}{note} | "
              f"${wfable[label]:,.0f} | {share(wfable[label], cap_f.get(label))} | "
              f"${scost[label]:,.0f} | {share(scost[label], cap_s.get(label))} |")
    if (len(ACCOUNTS) == 1 and "week" not in CAPACITY_1X) or ref_used:
        why = "tek hesap bulunduğu" if len(ACCOUNTS) == 1 else "canlı yüzdelerden kalibrasyon yapılamadığı"
        print(f"\nNot: {why} için kapasiteye referans taban kullanıldı (1x: haftalık "
              f"{REFERENCE_1X['week']} $, Fable {REFERENCE_1X['fable']} $, 5 saatlik {REFERENCE_1X['five']} $). "
              "Hesabı yalnız siz ve ağırlıklı Fable ile kullanıyorsanız paylar olduğundan düşük "
              "çıkabilir; kendi değerinizi --capacity-1x-week ile verin (README: Kalibrasyon).")

    for day in days:
        title = labels.get(day, "")
        print(f"\n## {title + ' ' if title else ''}({day})")
        for _, label, _ in ALL:
            rows = [(k[2], v) for k, v in tok.items()
                    if k[0] == label and k[1] == day and (v["in"] + v["out"] + v["cc"] + v["cr"])]
            if not rows:
                if label not in past:   # önceki hesap yalnızca kullanımı olan günlerde görünür
                    print(f"\n**{label}**: kullanım yok")
                continue
            tc = sum(dcost[(label, day, p)] for p, _ in rows)
            tf = sum(dfable[(label, day, p)] for p, _ in rows)
            print(f"\n**{label}** — tahmini ${tc:,.0f} → haftalık limitin {share(tc, cap_w.get(label))}'i, "
                  f"Fable limitinin {share(tf, cap_f.get(label))}'i\n")
            print("| Proje | Input | Output | Cache yazma | Cache okuma | Toplam | Maliyet | Haftalık pay | Fable pay |")
            print("|---|---:|---:|---:|---:|---:|---:|---:|---:|")
            tot = defaultdict(int)
            for proj, v in sorted(rows, key=lambda r: -dcost[(label, day, r[0])]):
                t = v["in"] + v["out"] + v["cc"] + v["cr"]
                c, cf = dcost[(label, day, proj)], dfable[(label, day, proj)]
                print(f"| {proj} | {fmt(v['in'])} | {fmt(v['out'])} | {fmt(v['cc'])} | {fmt(v['cr'])} | "
                      f"{fmt(t)} | ${c:,.0f} | {share(c, cap_w.get(label))} | {share(cf, cap_f.get(label))} |")
                for kk in v:
                    tot[kk] += v[kk]
            t = tot["in"] + tot["out"] + tot["cc"] + tot["cr"]
            print(f"| **Toplam** | **{fmt(tot['in'])}** | **{fmt(tot['out'])}** | **{fmt(tot['cc'])}** | "
                  f"**{fmt(tot['cr'])}** | **{fmt(t)}** | **${tc:,.0f}** | **{share(tc, cap_w.get(label))}** | "
                  f"**{share(tf, cap_f.get(label))}** |")
            ms = sorted(((m, o) for (aa, dd, m), o in mdl.items() if aa == label and dd == day and o),
                        key=lambda x: -x[1])
            print("Model (output): " + ", ".join(f"{m}: {fmt(o)}" for m, o in ms))
            if a.sessions:
                srows = sorted(((k[2], v) for k, v in stok.items()
                                if k[0] == label and k[1] == day and v["total"]),
                               key=lambda r: -scst[(label, day, r[0])])
                if srows:
                    print(f"\nOturumlar (en pahalı {min(a.sessions, len(srows))}/{len(srows)}):\n")
                    print("| Oturum | Proje | Output | Toplam | Mesaj | Maliyet | Haftalık pay | Fable pay |")
                    print("|---|---|---:|---:|---:|---:|---:|---:|")
                    for sid, v in srows[:a.sessions]:
                        c, cf = scst[(label, day, sid)], sfab[(label, day, sid)]
                        print(f"| {sess_name(sid)} `{sid[:8]}` | {sess_proj.get(sid, '?')} | {fmt(v['out'])} | "
                              f"{fmt(v['total'])} | {v['n']} | ${c:,.0f} | {share(c, cap_w.get(label))} | "
                              f"{share(cf, cap_f.get(label))} |")

    print("\n## Şu anki 5 saatlik pencere\n")
    for _, label, _ in ACCOUNTS:
        L = limits[label]
        if not L["five_reset"]:
            print(f"**{label}** — güncel pencere verisi yok (Claude Code'u bir kez açıp tekrar deneyin)\n")
            continue
        start = (parse_ts(L["five_reset"]) - timedelta(hours=5)).astimezone().strftime("%H:%M")
        rows = sorted(((p, c) for (aa, p), c in sproj.items() if aa == label), key=lambda x: -x[1])
        print(f"**{label}** — %{L['five']:.0f} dolu, {start} → {loc(L['five_reset'])}, "
              f"bu makineden ${scost[label]:,.0f} ({share(scost[label], cap_s.get(label))})\n")
        if rows:
            print("| Proje | Maliyet | 5s limit payı |")
            print("|---|---:|---:|")
            for p, c in rows:
                print(f"| {p} | ${c:,.0f} | {share(c, cap_s.get(label))} |")
        else:
            print("bu pencerede yerel kullanım yok")
        print()

    print("Notlar: maliyetler API liste fiyatıyla tahmindir (1 saatlik cache yazma 2 × input; advisor "
          "alt çağrıları advisor modelinin fiyatıyla dahil); limit payları kalibrasyona dayalıdır "
          "(plan çarpanı .claude.json'dan okunur). Hesaplar arası --resume yapılan oturumlarda "
          "her yanıt, önceki istemi gönderen hesaba yazılır.")


if __name__ == "__main__":
    main()
